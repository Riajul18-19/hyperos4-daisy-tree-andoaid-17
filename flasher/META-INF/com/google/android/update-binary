#!/sbin/sh
# HyperOS 4 TWRP/OrangeFox Installer for Xiaomi Mi A2 Lite (daisy) - Ported by Riajul
# Maintainer: Riajul

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo "ui_print $1" >> /proc/self/fd/$OUTFD
    echo "ui_print" >> /proc/self/fd/$OUTFD
}

set_progress() {
    echo "set_progress $1" >> /proc/self/fd/$OUTFD
}

set_progress 0.05

ui_print " "
ui_print "  _  _                      ___  ___   _ _  "
ui_print " | || |_  _ _ __  ___ _ _ / _ \/ __| | | | "
ui_print " | __ | || | '_ \/ -_) '_| (_) \__ \ |_  _| "
ui_print " |_||_|\_, | .__/\___|_|  \___/|___/   |_|  "
ui_print "       |__/|_|                              "
ui_print " "
ui_print "  HyperOS 4 (Android 17) for Mi A2 Lite - Ported by Riajul"
ui_print "  Device     : Xiaomi Mi A2 Lite (daisy)"
ui_print "  Maintainer : Riajul"
ui_print " "

# Detect current active slot
SLOT=$(getprop ro.boot.slot_suffix 2>/dev/null)
if [ -z "$SLOT" ]; then
    SLOT=$(grep -o 'androidboot.slot_suffix=_[ab]' /proc/cmdline 2>/dev/null | cut -d= -f2)
fi
if [ -z "$SLOT" ]; then
    SLOT=$(getprop ro.boot.slot 2>/dev/null)
    [ -n "$SLOT" ] && [ "${SLOT#_}" = "$SLOT" ] && SLOT="_${SLOT}"
fi

if [ "$SLOT" != "_a" ] && [ "$SLOT" != "_b" ]; then
    ui_print "[!] Error: Could not detect active slot!"
    exit 1
fi

SLOT_LETTER=$(echo "$SLOT" | tr 'a-z' 'A-Z' | tr -d '_')

ui_print "  Target Slot: Slot $SLOT_LETTER ($SLOT)"
ui_print "  Note: Installing into current active slot"
ui_print " "

find_block() {
    local part="$1"
    for p in \
        "/dev/block/bootdevice/by-name/${part}" \
        "/dev/block/by-name/${part}" \
        "/dev/block/platform/soc/7824900.sdhci/by-name/${part}"; do
        if [ -b "$p" ] || [ -L "$p" ]; then
            readlink -f "$p" 2>/dev/null || echo "$p"
            return 0
        fi
    done
    local found=$(find /dev/block -name "${part}" 2>/dev/null | head -n 1)
    if [ -n "$found" ]; then
        readlink -f "$found" 2>/dev/null || echo "$found"
        return 0
    fi
    return 1
}

BOOT_DEV=$(find_block "boot${SLOT}")
VENDOR_DEV=$(find_block "vendor${SLOT}")
SYSTEM_DEV=$(find_block "system${SLOT}")
SPLASH_DEV=$(find_block "splash")

if [ -z "$BOOT_DEV" ] || [ -z "$VENDOR_DEV" ] || [ -z "$SYSTEM_DEV" ]; then
    ui_print "[!] Error: Target partitions not found for slot ${SLOT}!"
    exit 1
fi

for mp in /system /system_root /vendor "$SYSTEM_DEV" "$VENDOR_DEV"; do
    umount "$mp" 2>/dev/null
    umount -l "$mp" 2>/dev/null
done
set_progress 0.15

flash_image() {
    local img_name="$1"
    local target_dev="$2"

    if unzip -p "$ZIPFILE" "$img_name" | dd of="$target_dev" bs=4194304 conv=notrunc,fsync 2>/dev/null || \
       unzip -p "$ZIPFILE" "$img_name" | dd of="$target_dev" bs=4194304 2>/dev/null; then
        sync
        return 0
    fi
    return 1
}

if [ -n "$SPLASH_DEV" ]; then
    ui_print "- Flashing splash logo (Android 17)..."
    flash_image "splash.img" "$SPLASH_DEV" 2>/dev/null || true
fi

ui_print "- Flashing boot (${SLOT} - OrangeFox Permanent)..."
if ! flash_image "boot.img" "$BOOT_DEV"; then
    ui_print "[!] Error flashing boot!"
    exit 1
fi
set_progress 0.35

ui_print "- Flashing vendor (${SLOT})..."
if ! flash_image "vendor.img" "$VENDOR_DEV"; then
    ui_print "[!] Error flashing vendor!"
    exit 1
fi
set_progress 0.60

ui_print "- Flashing system (${SLOT})..."
if ! flash_image "system.img" "$SYSTEM_DEV"; then
    ui_print "[!] Error flashing system!"
    exit 1
fi
set_progress 0.95

ui_print "- Cleaning stale package and dalvik caches..."
mount /data 2>/dev/null
rm -rf /data/system/package_cache 2>/dev/null
rm -rf /data/dalvik-cache 2>/dev/null
umount /data 2>/dev/null

sync
set_progress 1.00

ui_print " "
ui_print "- Installation Successful!"
ui_print "  OrangeFox Recovery is permanent."
ui_print "  KernelSU is built-in and supported out of the box."
ui_print " "
exit 0
